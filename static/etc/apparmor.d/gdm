#include <tunables/global>

profile gdm {
  #include <abstractions/base>
  #include <abstractions/dbus-strict>

  dbus (receive) bus=system path=/org/gnome/DisplayManager/Manager interface=org.freedesktop.DBus.Properties member={Get,GetAll} peer=(label=unconfined),
  dbus (receive) bus=system path=/org/gnome/DisplayManager/Manager interface=org.freedesktop.DBus.Properties member={Get,GetAll} peer=(label=snap.ubuntu-desktop-session.gnome-shell),
  dbus (receive) bus=system path=/org/gnome/DisplayManager/Manager interface=org.gnome.DisplayManager.Manager member={RegisterSession,RegisterDisplay,OpenSession} peer=(label=unconfined),
  dbus (receive) bus=system path=/org/gnome/DisplayManager/Manager interface=org.gnome.DisplayManager.Manager member={RegisterSession,RegisterDisplay,OpenSession,OpenReauthenticationChannel} peer=(label=snap.ubuntu-desktop-session.gnome-shell),
  dbus (send) bus=system path=/org/freedesktop/login1 interface=org.freedesktop.login1.Manager member={ListSeats,ActivateSessionOnSeat,UnlockSession} peer=(name=org.freedesktop.login1,label=unconfined),
  dbus (send) bus=system path=/org/freedesktop/Accounts interface=org.freedesktop.DBus.Properties member=GetAll,
  dbus (send) bus=system path=/org/freedesktop/Accounts interface=org.freedesktop.Accounts member={ListCachedUsers,FindUserByName,CacheUser},
  dbus (send) bus=system path=/org/freedesktop/Accounts/User* interface=org.freedesktop.DBus.Properties member=GetAll,
  dbus (send) bus=system path=/org/freedesktop/Accounts/User* interface=org.freedesktop.Accounts.User member=SetLanguage,
  dbus (bind) bus=system name=org.gnome.DisplayManager,
  dbus (send) bus=system path=/org/freedesktop/DBus interface=org.freedesktop.DBus member={RequestName,ReleaseName,GetConnectionUnixProcessID,GetConnectionUnixUser} peer=(name=org.freedesktop.DBus),

  /usr/libexec/gnome-content-launch ixr,
  /snap/gnome-desktop-content/*/usr/share/gdm/generate-config ixr,
  /snap/gnome-desktop-content/*/usr/sbin/gdm3 ix,
  /snap/gnome-desktop-content/*/usr/libexec/gdm-session-worker ix,
  # Keep the per-user session launcher outside the system-service profile so
  # snap-confine can transition into each desktop snap's own profile.
  /snap/gnome-desktop-content/*/usr/libexec/gdm-wayland-session Ux,
  /usr/bin/{setsid,setpriv,install,gnuinstall} ix,
  /usr/bin/pkill ix,
  /usr/bin/pgrep ix,
  /usr/lib/core/lockout-not-enabled.sh ix,
  /usr/sbin/unix_chkpwd Px -> unix-chkpwd,
  /usr/bin/gnome-keyring-daemon Ux,
  /snap/gnome-desktop-content/*/usr/bin/dconf ix,

  /snap/gnome-desktop-content/*/usr/lib/** mr,
  /snap/gnome-desktop-content/*/usr/share/gdm/** r,
  /snap/gnome-desktop-content/*/usr/lib/ r,
  /snap/gnome-desktop-content/*/usr/lib/*-linux-gnu/ r,
  /snap/gnome-desktop-content/*/usr/lib/gnome-shell/ r,
  /snap/gnome-desktop-content/*/usr/lib/gnome-settings-daemon-*/ r,
  /snap/gnome-desktop-content/*/usr/lib/*-linux-gnu/mutter-*/ r,
  /snap/gnome-desktop-content/*/lib/ r,
  /snap/gnome-desktop-content/*/lib/*-linux-gnu/ r,
  /snap/gnome-desktop-content/*/usr/lib/*-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders.cache r,
  /snap/gnome-desktop-content/*/usr/share/gdm/ r,
  /snap/gnome-desktop-content/*/usr/share/gdm/dconf/ r,
  /snap/gnome-desktop-content/*/usr/share/gdm/dconf/** r,
  /snap/gnome-desktop-content/*/usr/share/wayland-sessions/ r,
  /snap/gnome-desktop-content/*/usr/share/wayland-sessions/*.desktop r,
  /usr/share/gdm/** r,
  /etc/gdm3/custom.conf r,
  /etc/writable/gdm3/custom.conf r,
  /etc/writable/locale.conf r,
  /etc/pam.d/gdm-autologin r,
  /etc/pam.d/other r,
  /etc/login.defs r,
  /etc/security/limits.conf r,
  /etc/security/limits.d/ r,
  /etc/security/limits.d/* r,
  /etc/security/faillock.conf r,
  /etc/security/pam_env.conf r,
  /etc/environment r,
  /proc/keys r,
  /etc/pam.d/ r,
  /etc/pam.d/* r,
  /usr/share/wayland-sessions/ r,
  /usr/share/wayland-sessions/* r,
  /etc/nsswitch.conf r,
  /etc/machine-id r,
  /proc/sys/kernel/random/boot_id r,
  /etc/passwd r,
  /etc/group r,
  /etc/shadow r,
  /var/lib/ r,
  /var/lib/gdm3/ rw,
  /var/lib/gdm3/** rw,
  /var/lib/extrausers/group r,
  /var/lib/extrausers/passwd r,
  /var/lib/extrausers/shadow r,
  /run/systemd/userdb/io.systemd.Multiplexer rw,
  /run/systemd/io.systemd.Login rw,
  /run/systemd/userdb/io.systemd.DynamicUser rw,
  /run/systemd/userdb/ rw,
  /run/systemd/userdb/org.gnome.DisplayManager rw,
  /run/systemd/users/* r,
  /run/dbus/system_bus_socket rw,
  unix (bind, listen) type=stream addr="@*/bus/gdm-session-wor/system",
  /run/gdm3/ rw,
  /run/gdm3/home/ rw,
  /run/gdm3/home/**/ rw,
  /run/gdm3/home/** rw,
  /run/user/ r,
  /run/user/*/ r,
  /run/user/*/bus rw,
  /dev/tty0 rw,
  /dev/tty[0-9]* rw,
  /usr/bin/plymouth ix,
  /sys/devices/virtual/tty/tty0/active r,
  /run/systemd/seats/ r,
  /run/systemd/seats/** r,
  /run/systemd/sessions/ r,
  /run/systemd/sessions/** r,
  /run/systemd/sessions/* r,
  /run/systemd/seats/* r,
  /run/udev/data/** r,
  /sys/devices/pci*/** r,
  /run/udev/data/+drm:* r,
  /run/udev/data/+pci:* r,
  /sys/devices/pci*/uevent r,
  /sys/devices/pci*/**/{uevent,boot_vga,boot_display} r,
  /sys/fs/cgroup/user.slice/user-*.slice/session-*.scope/cgroup.events r,
  /run/udev/tags/master-of-seat/ r,
  /run/udev/tags/master-of-seat/* r,
  /proc/cmdline r,
  /run/gdm3/** rw,
  /run/gdm3.pid rw,
  /var/log/gdm3/ rw,
  /var/log/gdm3/** rw,
  /proc/ r,
  /proc/*/ r,
  /proc/tty/drivers r,
  /run/systemd/userdb/ r,
  /proc/*/{cgroup,cmdline,comm,stat,status} r,
  /proc/*/uid_map r,
  /proc/*/loginuid rw,
  /proc/*/task/*/attr/exec rw,
  capability chown,
  capability dac_override,
  capability dac_read_search,
  capability audit_write,
  capability fsetid,
  capability fowner,
  capability kill,
  capability setgid,
  capability sys_tty_config,
  capability setuid,
  signal (send) set=(term) peer=unconfined,
}
