#!/bin/bash -e

APPARMOR_PROF_D="etc/apparmor.d"

declare -A allowed_profs
allowed_profs[hostname]=""
allowed_profs[locale]=""
allowed_profs[lsblk]=""
allowed_profs[nc.openbsd]=""
allowed_profs[ssh-keyscan]=""
allowed_profs[systemd-coredump]=""
allowed_profs[systemd-detect-virt]=""
allowed_profs[unix-chkpwd]=""
allowed_profs[who]=""
# fuse3 (providing /usr/bin/fusermount3) is now a real, present binary -
# pulled in transitively by the desktop packages added in this rebase
# (xdg-desktop-portal/gvfs-style userspace mounts need it). The
# 800-remove-unneeded-profiles.chroot hook correctly keeps its apparmor
# profile since the binary genuinely exists now; this allowlist just
# needs to catch up.
allowed_profs[fusermount3]=""

num_prof=0

for profile in "$APPARMOR_PROF_D"/*; do
    # Skip if it is a directory
    if [ -d "$profile" ]; then
        continue
    fi
    # Skip if not a regular file
    if [ ! -f "$profile" ]; then
        continue
    fi
    num_prof=$((num_prof + 1))

    filename=$(basename "$profile")
    if ! [[ -v allowed_profs["$filename"] ]]; then
        printf "Apparmor profile %s is not allowed\n" "$filename"
        exit 1
    fi
done

if [ "$num_prof" -ne "${#allowed_profs[@]}" ]; then
    # If there were more we would have failed in the loop
    printf "Less number of apparmor profiles than expected\n"
    exit 1
fi
