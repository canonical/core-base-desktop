#!/bin/bash -e

test -x usr/libexec/provd
test -f usr/share/dconf/profile/gnome-initial-setup
test -f usr/share/gnome-initial-setup/initial-setup-dconf-defaults

# The initial-setup session must launch the Ubuntu wizard via the
# provision-init launcher (provd + ubuntu_init), not the removed Debian
# gnome-initial-setup wrapper.
grep -Fqx 'ExecStart=/usr/libexec/launch-desktop-provision-init' \
    usr/lib/systemd/user/gnome-initial-setup.service
grep -Fq 'DCONF_PROFILE= DESKTOP_PROVISION_PATH=/usr/share/desktop-provision /snap/ubuntu-desktop-init/current/bin/ubuntu_init' \
    usr/libexec/launch-desktop-provision-init

for path in \
    usr/lib/x86_64-linux-gnu/libwebkitgtk-6.0.so.4 \
    usr/lib/x86_64-linux-gnu/libwebkitgtk-6.0.so.4.* \
    usr/lib/x86_64-linux-gnu/webkitgtk-6.0 \
    usr/lib/x86_64-linux-gnu/libjavascriptcoregtk-6.0.so.1 \
    usr/lib/x86_64-linux-gnu/libjavascriptcoregtk-6.0.so.1.* \
    usr/lib/x86_64-linux-gnu/libLLVM-21.so \
    usr/lib/x86_64-linux-gnu/libLLVM.so.21.* \
    usr/lib/x86_64-linux-gnu/libgallium-*.so \
    usr/lib/x86_64-linux-gnu/dri/*_drv_video.so
do
    if [ -e "$path" ] || [ -L "$path" ]; then
        printf 'Unneeded provisioning UI payload remains: %s\n' "$path" >&2
        exit 1
    fi
done
