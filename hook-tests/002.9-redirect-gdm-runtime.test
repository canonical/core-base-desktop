#!/bin/bash -e

launcher=usr/libexec/gnome-content-launch
test -x "$launcher"
grep -Fqx '            target="$content_root/usr/${alias_path#/usr/}"' "$launcher"
grep -Fqx '                gdm|gdm-greeter|gdm-greeter-[0-9]*)' "$launcher"
grep -Fqx '        /usr/libexec/gdm-*|/usr/bin/dconf|/usr/libexec/gnome-session-ctl)' "$launcher"
grep -Fq '"$content_root"/usr/lib/gnome-shell \' "$launcher"
grep -Fq '"$content_root"/usr/lib/*-linux-gnu/mutter-* \' "$launcher"
grep -Fq '"$content_root"/usr/lib/*-linux-gnu/gjs/girepository-1.0 \' "$launcher"
grep -Fq 'GDK_PIXBUF_MODULE_FILE=$pixbuf_cache' "$launcher"
grep -Fq 'XCURSOR_PATH="$content_root/usr/share/icons:/usr/share/icons"' "$launcher"
grep -Fq 'if [ "${1-}" = "--session-dispatch" ]; then' "$launcher"
grep -Fq 'gnome-session-service)' "$launcher"
grep -Fq 'gnome-shell)' "$launcher"
grep -Fq 'gdm_gid=$(getent group gdm | cut -d: -f3)' "$launcher"
grep -Fq '[ "$target" = "$content_root/usr/libexec/gdm-wayland-session" ] &&' "$launcher"
grep -Fq '[ "${DESKTOP_SESSION-}" = "gnome-greeter" ] &&' "$launcher"
grep -Fq 'set -- "gnome-session --session=gnome-login"' "$launcher"
! grep -Fq 'CORE_FALLBACK' "$launcher"

grep -Fqx 'ExecStart=/usr/libexec/gnome-content-launch --session-dispatch gnome-session-service --session=%i' \
    usr/lib/systemd/user/gnome-session-manager@ubuntu.service.d/core-override.conf
grep -Fqx 'ExecStart=/usr/libexec/gnome-content-launch --session-dispatch gnome-shell --mode=%i' \
    usr/lib/systemd/user/org.gnome.Shell@ubuntu.service.d/core-override.conf

for executable in \
    usr/bin/dconf \
    usr/bin/gnome-session \
    usr/bin/gnome-shell \
    usr/libexec/gdm-auth-config-debian \
    usr/libexec/gdm-new-session \
    usr/libexec/gdm-runtime-config \
    usr/libexec/gdm-session-worker \
    usr/libexec/gdm-wayland-session \
    usr/libexec/gdm-x-session \
    usr/libexec/gnome-session-ctl \
    usr/libexec/gnome-session-init-worker \
    usr/libexec/gnome-session-service \
    usr/libexec/gsd-a11y-settings \
    usr/libexec/gsd-color \
    usr/libexec/gsd-datetime \
    usr/libexec/gsd-housekeeping \
    usr/libexec/gsd-keyboard \
    usr/libexec/gsd-media-keys \
    usr/libexec/gsd-power \
    usr/libexec/gsd-printer \
    usr/libexec/gsd-print-notifications \
    usr/libexec/gsd-rfkill \
    usr/libexec/gsd-screensaver-proxy \
    usr/libexec/gsd-sharing \
    usr/libexec/gsd-smartcard \
    usr/libexec/gsd-sound \
    usr/libexec/gsd-usb-protection \
    usr/libexec/gsd-wwan \
    usr/libexec/gsd-xsettings
do
    test -L "$executable"
    test "$(readlink "$executable")" = "/$launcher"
    test ! -e "${executable}.core26"
done

for directory in gdm gnome-settings-daemon gnome-shell; do
    test -L "usr/share/$directory"
    test "$(readlink "usr/share/$directory")" = \
        "/snap/gnome-desktop-content/current/usr/share/$directory"
    test ! -e "usr/share/$directory.core26"
done

test ! -e usr/share/gnome-shell/theme.core26
test -L usr/lib/gnome-shell
test "$(readlink usr/lib/gnome-shell)" = \
    /snap/gnome-desktop-content/current/usr/lib/gnome-shell
test ! -e usr/lib/gnome-shell.core26

test -L usr/lib/x86_64-linux-gnu/mutter-18
test "$(readlink usr/lib/x86_64-linux-gnu/mutter-18)" = \
    /snap/gnome-desktop-content/current/usr/lib/x86_64-linux-gnu/mutter-18
test ! -e usr/lib/x86_64-linux-gnu/mutter-18.core26

test -L usr/share/gnome-session/sessions/gnome-login.session
test "$(readlink usr/share/gnome-session/sessions/gnome-login.session)" = \
    /snap/gnome-desktop-content/current/usr/share/gnome-session/sessions/gnome-login.session
test ! -e usr/share/gnome-session/sessions/gnome-login.session.core26
# The host does not need ubuntu.session; the confined user session supplies it.
test ! -e usr/share/gnome-session/sessions/ubuntu.session
for unit in \
    gnome-session-basic-services.target \
    gnome-session-initialized.target \
    gnome-session-manager.target \
    gnome-session-manager@.service \
    gnome-session-monitor.service \
    gnome-session-pre.target \
    gnome-session-restart-dbus.service \
    gnome-session-services.target \
    gnome-session-shutdown.target \
    gnome-session-signal-init.service \
    gnome-session-x11-services-ready.target \
    gnome-session-x11-services.target \
    gnome-session.target \
    gnome-session@.target \
    org.gnome.Shell-disable-extensions.service \
    org.gnome.Shell@.service
do
    test -L "usr/lib/systemd/user/$unit"
    test "$(readlink "usr/lib/systemd/user/$unit")" = \
        "/snap/gnome-desktop-content/current/usr/lib/systemd/user/$unit"
done
for component in \
    A11ySettings \
    Color \
    Datetime \
    Housekeeping \
    Keyboard \
    MediaKeys \
    Power \
    PrintNotifications \
    Rfkill \
    ScreensaverProxy \
    Sharing \
    Smartcard \
    Sound \
    UsbProtection \
    Wwan \
    XSettings
do
    for type in target service; do
        unit="org.gnome.SettingsDaemon.$component.$type"
        test -L "usr/lib/systemd/user/$unit"
        test "$(readlink "usr/lib/systemd/user/$unit")" = \
            "/snap/gnome-desktop-content/current/usr/lib/systemd/user/$unit"
    done
done
for dropin in \
    gnome-session@gnome-login.target.d/gnome-login.session.conf \
    gnome-session@ubuntu.target.d/ubuntu.session.conf
do
    test -L "usr/lib/systemd/user/$dropin"
    test "$(readlink "usr/lib/systemd/user/$dropin")" = \
        "/snap/gnome-desktop-content/current/usr/lib/systemd/user/$dropin"
done

test ! -e usr/sbin/gdm3
test ! -e usr/bin/gdm-config
test ! -e usr/libexec/gnome-shell-perf-helper
test ! -e usr/share/gdm.core26
test -f usr/lib/systemd/system/gdm.service
test -L usr/lib/systemd/system/gdm3.service
test -d etc/gdm3
test -f etc/pam.d/gdm-password
test -f usr/share/dbus-1/system.d/gdm.conf
test -f usr/lib/sysusers.d/gdm3.conf
test -f usr/share/dconf/profile/gnome-initial-setup
test -f usr/share/gnome-initial-setup/initial-setup-dconf-defaults

dropin=etc/systemd/system/gdm.service.d/50-gnome-content.conf
grep -Fqx 'ExecStartPre=/usr/libexec/gnome-content-launch --content /snap/gnome-desktop-content/current/usr/share/gdm/generate-config' "$dropin"
grep -Fqx 'ExecStart=/usr/libexec/gnome-content-launch --content /snap/gnome-desktop-content/current/usr/sbin/gdm3' "$dropin"
grep -Fqx 'ExecReload=/bin/kill -SIGHUP $MAINPID' "$dropin"
grep -Fqx 'AppArmorProfile=gdm' "$dropin"
test -f etc/apparmor.d/gdm
grep -Fqx 'profile gdm {' etc/apparmor.d/gdm
grep -Fqx '  #include <abstractions/dbus-strict>' etc/apparmor.d/gdm
grep -Fqx '  /usr/libexec/gnome-content-launch ixr,' etc/apparmor.d/gdm
grep -Fqx '  /usr/lib/core/lockout-not-enabled.sh ix,' etc/apparmor.d/gdm
grep -Fqx '  /snap/gnome-desktop-content/*/usr/sbin/gdm3 ix,' etc/apparmor.d/gdm
grep -Fqx '  /snap/gnome-desktop-content/*/usr/libexec/gdm-session-worker ix,' etc/apparmor.d/gdm
grep -Fqx '  /snap/gnome-desktop-content/*/usr/libexec/gdm-wayland-session Ux,' etc/apparmor.d/gdm
grep -Fqx '  capability dac_override,' etc/apparmor.d/gdm
grep -Fqx '  /proc/*/task/*/attr/exec rw,' etc/apparmor.d/gdm
grep -Fqx '  /run/systemd/users/* r,' etc/apparmor.d/gdm
grep -Fqx '  /etc/security/faillock.conf r,' etc/apparmor.d/gdm
grep -Fq 'member={RequestName,ReleaseName,GetConnectionUnixProcessID,GetConnectionUnixUser}' etc/apparmor.d/gdm
grep -Fqx '  signal (send) set=(term) peer=unconfined,' etc/apparmor.d/gdm
