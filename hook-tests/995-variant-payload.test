#!/bin/bash

# Verifies the variant payload machinery (tools/apply-variant-payload.sh):
#
# * desktop builds: the primed /etc/fstab and
#   /usr/lib/tmpfiles.d/core-writable.conf must be the pre-payload
#   files with the desktop variant's fragments appended exactly once
#   (no duplication, nothing else changed) -- the fragments are
#   stripped and re-applied here and compared;
# * regular builds: the base fstab and core-writable.conf must be
#   primed unchanged, with no desktop fragments applied at all;
# * a synthetic payload must have its knobs applied (static file
#   copied, fstab and core-writable.conf fragments appended).

set -eu

src="$(cd "$(dirname "$0")/.." && pwd)"
sysroot="${PWD}"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# Concatenate a fragment directory the way apply-variant-payload.sh
# appends it: glob order, byte for byte. Every fragment must be a
# complete set of newline-terminated lines.
cat_fragments() {
    local dir="$1" out="$2" f
    : > "$out"
    for f in "$dir"/*.conf; do
        [ -e "$f" ] || continue
        if [ -n "$(tail -c 1 "$f")" ]; then
            echo "E: fragment $f does not end with a newline" >&2
            exit 1
        fi
        cat "$f" >> "$out"
    done
}

# Write the pre-payload content of a merged file: if the merged file
# ends with exactly the fragment bytes, strip them (they were applied
# by the build); otherwise the merged file is still pre-payload.
pre_payload() {
    local merged="$1" frags="$2" out="$3" merged_size frag_size
    merged_size=$(stat -c %s "$merged")
    frag_size=$(stat -c %s "$frags")
    if [ "$frag_size" -gt 0 ] && [ "$merged_size" -ge "$frag_size" ] \
            && tail -c "$frag_size" "$merged" | cmp -s - "$frags"; then
        head -c $((merged_size - frag_size)) "$merged" > "$out"
    else
        cp "$merged" "$out"
    fi
}

# --- the shipped desktop payload must be applied exactly once ---
# --- (or not at all on non-desktop builds) ---

cat_fragments "$src/variants/desktop/fstab.d" "$tmp/fstab.frags"
cat_fragments "$src/variants/desktop/writable.conf.d" "$tmp/writable.frags"

# The desktop variant is identified by its baked payload (hook-tests do
# not run with SNAP_BUILD_VARIANT exported), as in 018/800.
if [ -e "$sysroot/etc/pam.d/gdm-password" ]; then
    pre_payload "$sysroot/etc/fstab" "$tmp/fstab.frags" "$tmp/fstab.pre"
    pre_payload "$sysroot/usr/lib/tmpfiles.d/core-writable.conf" \
        "$tmp/writable.frags" "$tmp/writable.pre"

    # the pre-payload fstab must still be the base static one
    cmp "$src/static/etc/fstab" "$tmp/fstab.pre"

    # re-applying the payload to the pre-payload files must rebuild the
    # primed files exactly
    mkdir -p "$tmp/rootfs/etc" "$tmp/rootfs/usr/lib/tmpfiles.d"
    cp "$tmp/fstab.pre" "$tmp/rootfs/etc/fstab"
    cp "$tmp/writable.pre" "$tmp/rootfs/usr/lib/tmpfiles.d/core-writable.conf"
    "$src/tools/apply-variant-payload.sh" "$tmp/rootfs" desktop

    cmp "$sysroot/etc/fstab" "$tmp/rootfs/etc/fstab"
    cmp "$sysroot/usr/lib/tmpfiles.d/core-writable.conf" \
        "$tmp/rootfs/usr/lib/tmpfiles.d/core-writable.conf"

    echo "desktop variant payload is applied exactly once"
else
    # regular build: the base fstab and core-writable.conf are primed
    # unchanged, with no desktop fragments appended (a desktop payload
    # leaking into a regular build shows up as a mismatch here, and as
    # fragment lines in the files)
    cmp "$src/static/etc/fstab" "$sysroot/etc/fstab"
    cmp "$src/static/usr/lib/tmpfiles.d/core-writable.conf" \
        "$sysroot/usr/lib/tmpfiles.d/core-writable.conf"

    echo "regular build carries no desktop payload"
fi

# --- a synthetic payload must exercise every knob ---

mkdir -p "$tmp/src/tools" \
         "$tmp/rootfs/etc" \
         "$tmp/rootfs/usr/lib/tmpfiles.d" \
         "$tmp/src/variants/testvar/static/usr/share/example" \
         "$tmp/src/variants/testvar/fstab.d" \
         "$tmp/src/variants/testvar/writable.conf.d"
: > "$tmp/rootfs/etc/fstab"
: > "$tmp/rootfs/usr/lib/tmpfiles.d/core-writable.conf"
cp "$src/tools/apply-variant-payload.sh" "$tmp/src/tools/"
printf 'example\n' > "$tmp/src/variants/testvar/static/usr/share/example/data"
printf '# testvar fstab fragment\n' \
    > "$tmp/src/variants/testvar/fstab.d/10-test.conf"
printf '# testvar writable.conf fragment\n' \
    > "$tmp/src/variants/testvar/writable.conf.d/20-test.conf"

"$tmp/src/tools/apply-variant-payload.sh" "$tmp/rootfs" testvar

cmp -s "$tmp/src/variants/testvar/static/usr/share/example/data" \
       "$tmp/rootfs/usr/share/example/data"
tail -1 "$tmp/rootfs/etc/fstab" | grep -q '^# testvar fstab fragment$'
tail -1 "$tmp/rootfs/usr/lib/tmpfiles.d/core-writable.conf" \
    | grep -q '^# testvar writable.conf fragment$'

echo "variant payload knobs apply correctly"
