#!/bin/sh
if [ -n "$SNAP_NAME" ]; then
  exec /usr/bin/gnome-session.real "$@"
else
  case "$(id -un)" in
    gdm|gdm-greeter|gdm-greeter-[0-9]*|gnome-initial-setup|gnome-initial-setup-[0-9]*)
      exec /usr/bin/gnome-session.real "$@"
      ;;
    *)
      exec /usr/bin/core-desktop-session-wrapper.sh ubuntu-desktop-session ubuntu:GNOME
      ;;
  esac
fi
