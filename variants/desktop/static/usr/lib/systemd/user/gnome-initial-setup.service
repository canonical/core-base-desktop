[Unit]
Description=GNOME Initial Setup
RefuseManualStart=true
RefuseManualStop=true

BindsTo=gnome-session.target
After=gnome-session.target

[Service]
Type=simple
# provd is a confined user-scope snap daemon now (snap.provd.provd.service,
# started by this user manager itself; a ConditionGroup=gnome-initial-setup
# drop-in keeps it dormant for every other user). This unit only execs the
# wizard UI after provd's gRPC socket appears - the same raw-exec'd,
# unconfined UI as before. DCONF_PROFILE is cleared for the UI's Flutter
# gsettings package (cannot parse the gnome-initial-setup profile's
# file-db source; GNOME itself keeps the profile). DESKTOP_PROVISION_PATH
# points at the host whitelabel config baked in the base.
#
# Library resolution: the UI resolves its desktop closure from the
# gnome-desktop-runtime content snap (LD_LIBRARY_PATH +
# GSETTINGS_SCHEMA_DIR + GDK_PIXBUF_MODULE_FILE + GIO_EXTRA_MODULES - the
# same content-snap env split gnome-content-launch applies for the session
# side). provd's own env lives in its snap's app environment.
ExecStart=/bin/sh -c 'mkdir -p /run/gnome-initial-setup/desktop-provision /run/gnome-initial-setup/.cache; until [ -S /run/gnome-initial-setup/desktop-provision/init.socket ]; do sleep 1; done; exec env LD_LIBRARY_PATH=/snap/gnome-desktop-runtime/current/usr/lib/x86_64-linux-gnu:/snap/provd/current/usr/lib/x86_64-linux-gnu GIO_EXTRA_MODULES=/snap/gnome-desktop-runtime/current/usr/lib/x86_64-linux-gnu/gio/modules GSETTINGS_SCHEMA_DIR=/snap/gnome-desktop-runtime/current/usr/share/glib-2.0/schemas GDK_PIXBUF_MODULE_FILE=/snap/gnome-desktop-runtime/current/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders.cache DCONF_PROFILE= DESKTOP_PROVISION_PATH=/usr/share/desktop-provision DBUS_SESSION_BUS_ADDRESS="unix:path=$$XDG_RUNTIME_DIR/bus" /snap/ubuntu-desktop-init/current/bin/ubuntu_init'
ExecStopPost=-/usr/libexec/gnome-session-ctl --shutdown
Restart=no
