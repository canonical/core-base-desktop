[Unit]
Description=GNOME Initial Setup
RefuseManualStart=true
RefuseManualStop=true

BindsTo=gnome-session.target
After=gnome-session.target

[Service]
Type=simple
# provd is a confined user-scope snap daemon now (snap.provd.provd.service,
# started by this user manager itself; a ConditionGroup=gnome-initial-setup
# drop-in keeps it dormant for every other user). This unit only execs the
# wizard UI after provd's gRPC socket appears - the same raw-exec'd,
# unconfined UI as before. DCONF_PROFILE is UNSET (not set empty) for the
# UI's Flutter gsettings package: the package cannot parse the
# gnome-initial-setup profile's file-db source, but it also treats an
# empty DCONF_PROFILE as a profile *name*, looks for a profile file
# called "", finds none and fails every write with "No DConf source to
# write to" (two unhandled exceptions at UI startup, observed live).
# Unset makes it use the default user dconf source.
#
# XDG_CONFIG_HOME points at the session snap's common config redirect,
# the same one the session's dconf service writes. The Dart client reads
# the user db FILE directly (only writes go over the bus to the
# service), so without the redirect it would read $HOME/.config/dconf/
# user and never see what it (or the rest of the session) wrote.
# DESKTOP_PROVISION_PATH points at the host whitelabel config baked in
# the base.
#
# Library resolution: the UI resolves its desktop closure from the
# gnome-desktop-runtime content snap (LD_LIBRARY_PATH +
# GSETTINGS_SCHEMA_DIR + GDK_PIXBUF_MODULE_FILE + GIO_EXTRA_MODULES - the
# same content-snap env split gnome-content-launch applies for the session
# side). provd's own env lives in its snap's app environment.
#
# The multiarch placeholder token in ExecStart below (an @-delimited
# word) is substituted with the build environment's Debian multiarch
# triplet when the variant payload is applied
# (tools/apply-variant-payload.sh); it is not a systemd specifier and
# must not be read as a literal path component.
ExecStart=/bin/sh -c 'mkdir -p /run/gnome-initial-setup/desktop-provision /run/gnome-initial-setup/.cache; until [ -S /run/gnome-initial-setup/desktop-provision/init.socket ]; do sleep 1; done; exec env -u DCONF_PROFILE LD_LIBRARY_PATH=/snap/gnome-desktop-runtime/current/usr/lib/@MULTIARCH@:/snap/provd/current/usr/lib/@MULTIARCH@ GIO_EXTRA_MODULES=/snap/gnome-desktop-runtime/current/usr/lib/@MULTIARCH@/gio/modules GSETTINGS_SCHEMA_DIR=/snap/gnome-desktop-runtime/current/usr/share/glib-2.0/schemas GDK_PIXBUF_MODULE_FILE=/snap/gnome-desktop-runtime/current/usr/lib/@MULTIARCH@/gdk-pixbuf-2.0/2.10.0/loaders.cache DESKTOP_PROVISION_PATH=/usr/share/desktop-provision XDG_CONFIG_HOME="$$HOME/snap/ubuntu-desktop-session/common/.config" DBUS_SESSION_BUS_ADDRESS="unix:path=$$XDG_RUNTIME_DIR/bus" /snap/ubuntu-desktop-init/current/bin/ubuntu_init'
ExecStopPost=-/usr/libexec/gnome-session-ctl --shutdown
Restart=no
