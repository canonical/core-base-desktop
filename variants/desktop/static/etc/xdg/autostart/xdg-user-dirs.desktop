[Desktop Entry]
Type=Application
Name=User folders update
TryExec=/snap/bin/ubuntu-desktop-session.xdg-user-dirs-update
Exec=/snap/bin/ubuntu-desktop-session.xdg-user-dirs-update
StartupNotify=false
NoDisplay=true
X-Ubuntu-Gettext-Domain=xdg-user-dirs
X-GNOME-Autostart-Phase=Initialization
X-KDE-autostart-phase=1
X-systemd-skip=true
