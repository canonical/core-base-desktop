#!/bin/bash
#
# tmpfiles.d(5) will copy files from /usr/share/factory. So
# files/directories that need to be populated in /writable have to be
# copied there.
#
# /usr/lib/tmpfiles.d/core-writable.conf is the configuration file
# that describes the copy of those files/directories.

set -eux

ROOTDIR=$1

mkdir -p /usr/share/factory/writable/user-data

export GLOBIGNORE=.:..
for file in "$ROOTDIR"/home/*; do
    if [ -e "${file}" ]; then
        echo "${ROOTDIR}/home is not empty" >&2
        exit 1
    fi
done

dirs=(
    /root
    /etc/cloud
    /etc/dbus-1
    /etc/default/swapfile
    /etc/environment
    /etc/hosts
    /etc/machine-id
    /etc/modprobe.d
    /etc/modules-load.d
    /etc/motd.d
    /etc/netplan
    /etc/network/if-up.d
    /etc/security/pwquality.conf
    /etc/ssh
    /etc/sudoers.d
    /etc/sysctl.d
    /etc/systemd
    /etc/udev/rules.d
    /etc/update-motd.d
    /etc/writable
    /var/cache/apparmor
    /var/cache/snapd
    /var/lib/console-conf
    /var/lib/dhcpcd
    /var/lib/extrausers
    /var/lib/misc
    /var/lib/private/systemd
    /var/lib/snapd
    /var/lib/systemd
    /var/log
    /var/snap
    /var/tmp
)

# The desktop variant adds writable paths (see variants/desktop/):
# their factory templates are copies of the rootfs's own directories,
# exactly like the base list above. The mount points themselves are
# shipped through variants/desktop/static/.
case "${SNAP_BUILD_VARIANT:-}" in
    desktop)
        dirs+=(
            /etc/colord
            /etc/dconf
            /etc/firefox
            /etc/gdm3
            /var/lib/AccountsService
            /var/lib/gdm3
            /usr/share/wayland-sessions
            /usr/share/polkit-1
            /var/lib/colord
            /var/lib/fprint
        )
        ;;
esac

# /etc/dconf (the wizard accessibility handover channel, see
# writable.conf.d/desktop.conf): the desktop variant owns the mode of
# the rootfs directory so the factory copy below ships it and the fstab
# bind has a mount point.
if [ "${SNAP_BUILD_VARIANT:-}" = desktop ]; then
    # The directory itself is dconf's system config dir: enforce it
    # root:root 0755 - unprivileged users must not be able to plant
    # profiles or dbs into it. The wizard-uid handover write goes to the
    # group-restricted channel subdir (/etc/dconf/channel/handover,
    # root:gnome-initial-setup 1770) created and re-enforced at boot by
    # variants/desktop/static/usr/lib/tmpfiles.d/ucd-handover.conf, so
    # the top directory never needs to be writable. An existing tree
    # (a reused build environment, or a slice shipping it in the
    # future) is re-owned loudly rather than trusted; only a
    # non-directory fails.
    if [ -e "${ROOTDIR}/etc/dconf" ]; then
        if [ ! -d "${ROOTDIR}/etc/dconf" ] || [ -L "${ROOTDIR}/etc/dconf" ]; then
            echo "ERROR: ${ROOTDIR}/etc/dconf exists and is not a directory" >&2
            exit 1
        fi
        echo "I: /etc/dconf already exists; enforcing root:root 0755 on the factory template"
        chown 0:0 "${ROOTDIR}/etc/dconf"
        chmod 0755 "${ROOTDIR}/etc/dconf"
    else
        mkdir -m 0755 -p "${ROOTDIR}/etc/dconf"
    fi
    # The chroot hooks (005-initialize-systemd.chroot) already ran
    # systemd-tmpfiles over this tree, so the channel subdir may exist
    # with the build chroot's transient numeric gid for the
    # provisioning group. Ship a neutral root:root template with the
    # sticky group-write bits; the boot tmpfiles rule assigns the
    # runtime gnome-initial-setup group by name and re-enforces the
    # modes on every boot.
    if [ -d "${ROOTDIR}/etc/dconf/channel/handover" ]; then
        echo "I: resetting the shipped /etc/dconf channel template to root:root (modes preserved)"
        chown -R 0:0 "${ROOTDIR}/etc/dconf"
        chmod 0755 "${ROOTDIR}/etc/dconf" "${ROOTDIR}/etc/dconf/channel"
        chmod 1770 "${ROOTDIR}/etc/dconf/channel/handover"
    fi
fi

for dir in "${dirs[@]}"; do
    parent="$(dirname "${dir}")"
    mkdir -p "${ROOTDIR}/usr/share/factory/writable/system-data${parent}"
    cp -a "${ROOTDIR}${dir}" "${ROOTDIR}/usr/share/factory/writable/system-data${parent}"
done
