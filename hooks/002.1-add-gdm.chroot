#!/bin/sh -x

set -e

# Note: this used to apt-get install GDM/GNOME/PAM packages here. Under
# chisel there's no apt/dpkg in the build chroot at all - those packages
# are now fetched via snapcraft's stage-packages mechanism (see the
# gdm-packages part in snapcraft.yaml) and
# are already unpacked into the rootfs by the time this hook runs. This
# hook now only does the post-install configuration that used to follow
# those apt-get calls. Session-only packages are provided by the
# gnome-desktop-runtime snap.

# Remove setuid from some executables we're not using. Note: chisel's
# polkitd slices (bins/daemon/services - see snapcraft.yaml) deliberately
# don't ship /usr/bin/pkexec at all, so there's usually nothing to do
# here; keep the chmod guarded in case a later package pulls it in via
# stage-packages.
if [ -e /usr/bin/pkexec ]; then
    chmod u-s,g-s /usr/bin/pkexec
fi

# Remove Ubuntu X11 session
rm -f /usr/share/xsessions/ubuntu.desktop

# Move display-manager.service symlink out of /etc
rm -f /etc/systemd/system/display-manager.service
ln -s gdm.service /lib/systemd/system/display-manager.service
# Delay gdm until snapd.seeded and cloud-config are complete
sed -i '/^Description=/ a # delay until snapd finishes seeding\nAfter=snapd.seeded.service' /lib/systemd/system/gdm.service

# Remove D-Bus service activation files provided by
# ubuntu-desktop-session snap.
rm -f /usr/share/dbus-1/services/org.gnome.Nautilus.service
rm -f /usr/share/dbus-1/services/org.gnome.Terminal.service
rm -f /usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.gnome.service
rm -f /usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.gtk.service
rm -f /usr/share/dbus-1/services/org.gnome.Shell.Screencast.service
rm -f /usr/share/dbus-1/services/org.freedesktop.IBus.service
rm -f /usr/share/dbus-1/services/org.freedesktop.portal.IBus.service
rm -f /usr/share/dbus-1/services/org.freedesktop.ColorHelper.service

# Remove un-needed D-Bus service activation files
rm -f /usr/share/dbus-1/services/org.gnome.evolution.dataserver.*

# Remove systemd activation in services managed by
# ubuntu-desktop-session snap
#
# (pipewire/wireplumber's own systemd units aren't staged here at all
# any more - item 13 of the rebase stops bundling those packages in the
# base image entirely, see gdm-packages' snapcraft.yaml comment - so
# there's nothing left to remove for them specifically.)
rm -rf /etc/systemd/user/pipewire*
rm -f /etc/systemd/user/sockets.target.wants/pipewire*
rm -f /etc/systemd/user/default.target.wants/pipewire*
rm -f /usr/lib/systemd/user/org.freedesktop.IBus.session.GNOME.service
rm -f /usr/lib/systemd/user/org.freedesktop.IBus.session.generic.service
rm -f /usr/lib/systemd/user/gnome-session.target.wants/org.freedesktop.IBus.session.GNOME.service
rm -f /usr/lib/systemd/user/colord-session.service

# LocalSearch and TinySPARQL are user-session services supplied by
# gnome-desktop-runtime. The host GDM greeter does not use file indexing
# or the Tracker portal, so remove their package payload from the base.
rm -f /usr/bin/localsearch /usr/bin/tinysparql
rm -f /usr/libexec/localsearch* /usr/libexec/tinysparql*
rm -rf /usr/lib/*/localsearch-3.0 /usr/lib/*/tinysparql-3.0
rm -f /usr/lib/*/libtinysparql-3.0.so*
rm -f /usr/lib/systemd/user/localsearch*.service
rm -f /usr/lib/systemd/user/tinysparql-xdg-portal-3.service
rm -f /usr/share/dbus-1/services/org.freedesktop.LocalSearch3*.service
rm -f /usr/share/dbus-1/services/org.freedesktop.Tracker3*.service
rm -f /usr/share/dbus-1/services/org.freedesktop.portal.Tracker.service
rm -f /usr/share/dbus-1/interfaces/org.freedesktop.Tracker3*.xml
rm -f /usr/share/glib-2.0/schemas/org.freedesktop.Tracker3.*.gschema.xml
rm -f /usr/share/glib-2.0/schemas/org.freedesktop.TrackerMiners3.enums.xml
rm -rf /usr/share/doc/localsearch /usr/share/doc/tinysparql
rm -rf /usr/share/doc/libtinysparql-3.0-0
rm -rf /usr/share/bug/localsearch /usr/share/bug/tinysparql
rm -f /usr/share/lintian/overrides/localsearch
rm -f /usr/share/bash-completion/completions/localsearch
rm -f /usr/share/bash-completion/completions/tinysparql
rm -f /usr/share/man/man1/localsearch*.gz
rm -f /usr/share/man/man1/tinysparql*.gz
rm -f /usr/lib/sysctl.d/30-localsearch.conf
rm -f /etc/xdg/autostart/localsearch-3.desktop

# The Settings app, portal backends, and Bluetooth SPA modules are
# supplied by gnome-desktop-runtime and are not used by the host greeter.
rm -f /usr/bin/gnome-control-center
rm -f /usr/libexec/gnome-control-center*
rm -f /usr/libexec/xdg-desktop-portal
rm -f /usr/libexec/xdg-desktop-portal-gnome
rm -f /usr/libexec/xdg-desktop-portal-gtk
rm -f /usr/libexec/xdg-desktop-portal-rewrite-launchers
rm -f /usr/libexec/xdg-document-portal /usr/libexec/xdg-permission-store
rm -f /usr/lib/systemd/user/xdg-desktop-portal.service
rm -f /usr/lib/systemd/user/xdg-desktop-portal-gnome.service
rm -f /usr/lib/systemd/user/xdg-desktop-portal-gtk.service
rm -f /usr/lib/systemd/user/xdg-document-portal.service
rm -f /usr/lib/systemd/user/xdg-permission-store.service
rm -rf /usr/lib/*/spa-0.2/bluez5 /usr/share/spa-0.2/bluez5
rm -rf /usr/share/doc/gnome-control-center /usr/share/doc/gnome-control-center-data
rm -f /usr/share/lintian/overrides/gnome-control-center
rm -f /usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.gnome.service
rm -f /usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.gtk.service
rm -f /usr/share/dbus-1/services/org.freedesktop.impl.portal.PermissionStore.service
rm -f /usr/share/dbus-1/services/org.freedesktop.impl.portal.Secret.service
rm -f /usr/share/dbus-1/services/org.freedesktop.portal.Desktop.service
rm -f /usr/share/dbus-1/services/org.freedesktop.portal.Documents.service
rm -f /usr/share/dbus-1/services/org.gnome.Settings*.service
rm -f /usr/share/dbus-1/services/org.gnome.ControlCenter*.service
rm -rf /usr/share/xdg-desktop-portal/portals
rm -rf /usr/share/gnome-control-center
rm -f /usr/share/applications/org.gnome.Settings.desktop
rm -f /usr/share/polkit-1/rules.d/gnome-control-center.rules
rm -f /usr/share/metainfo/org.gnome.Settings.appdata.xml
rm -f /usr/share/man/man1/gnome-control-center.1.gz
rm -f /usr/bin/nautilus /usr/bin/nautilus-autorun-software
rm -rf /usr/lib/*/nautilus
rm -f /usr/lib/*/libnautilus-extension.so*
rm -rf /usr/share/nautilus
rm -rf /usr/share/doc/nautilus /usr/share/doc/nautilus-data
rm -rf /usr/share/doc/libnautilus-extension4
rm -f /usr/share/apport/package-hooks/source_nautilus.py
rm -f /usr/share/applications/nautilus-autorun-software.desktop
rm -f /usr/share/man/man1/nautilus*.gz
rm -f /usr/share/glib-2.0/schemas/org.gnome.nautilus.gschema.xml
rm -f /usr/share/applications/xdg-desktop-portal-gnome.desktop
rm -f /usr/share/applications/xdg-desktop-portal-gtk.desktop
rm -rf /usr/share/xdg-desktop-portal/gnome-portals.conf

# These user-session extensions are provided by gnome-desktop-runtime.
# The host GDM greeter runs GNOME Shell's dedicated greeter mode instead.
for extension in \
    ding@rastersoft.com \
    snapd-prompting@canonical.com \
    snapd-search-provider@canonical.com \
    tiling-assistant@ubuntu.com \
    ubuntu-appindicators@ubuntu.com \
    ubuntu-dock@ubuntu.com \
    web-search-provider@ubuntu.com
do
    rm -rf "/usr/share/gnome-shell/extensions/${extension}"
done

# GNOME Shell activates these snap-provided services in the greeter
# session. Their snap confinement rejects GDM's dynamic home under
# /run/gdm3/home as outside /home. In particular, the PermissionStore
# activation times out in the greeter. These services are optional in
# GDM mode but remain available in regular user sessions.
for service in \
    snap.ubuntu-desktop-session.xdg-permission-store.service \
    snap.ubuntu-desktop-session.screencast-service.service \
    snap.ubuntu-desktop-session.ibus-portal-service.service
do
    mkdir -p "/etc/systemd/user/${service}.d"
    cat >"/etc/systemd/user/${service}.d/70-gdm-skip.conf" <<'EOF'
# Do not run this unit in a gdm-greeter session
[Unit]
ConditionGroup=!gdm
EOF
done

# The greeter is not a user session and has no user SSH credentials. Keep
# the host SSH agent available to ordinary sessions, but don't start it
# in the GDM user manager.
mkdir -p /etc/systemd/user/ssh-agent.service.d
cat >/etc/systemd/user/ssh-agent.service.d/70-gdm-skip.conf <<'EOF'
# Do not run this unit in a gdm-greeter session
[Unit]
ConditionGroup=!gdm
EOF
mkdir -p /etc/systemd/user/ssh-agent.socket.d
cat >/etc/systemd/user/ssh-agent.socket.d/70-gdm-skip.conf <<'EOF'
# Do not listen for SSH agent requests in a gdm-greeter session
[Unit]
ConditionGroup=!gdm
EOF

# Disable console-conf, since it interferes with GDM taking over
# /dev/tty1.  Due to the ExecStartPre/ExecStopPost commands, we can't
# reliably get rid of it with Conflicts/After
mkdir /var/lib/console-conf
touch /var/lib/console-conf/complete
# gnome-initial-setup uses AccountsService to create the user account.
# AccountsService in turn calls /usr/sbin/adduser.  So configure
# adduser to add users to the "extrausers" database.
sed -i 's/^#USE_EXTRAUSERS=.*$/USE_EXTRAUSERS=1/' /etc/adduser.conf

# This gdm3 is built with HAVE_USERDB (varlink-based dynamic user
# support): rather than needing a real, pre-provisioned "gdm-greeter"
# system account, gdm3 allocates one on the fly and advertises it to
# the rest of the system as a userdb "multiplexer" service, registering
# a socket at /run/systemd/userdb/org.gnome.DisplayManager. nsswitch.conf
# needs "systemd" wired in for pam_unix's classic getpwnam("gdm-greeter")
# to see it - see hooks/013-setup-extrausers.chroot, which sets this up
# alongside the "extrausers" entries, for why and in what order.

# The 10_ubuntu-settings.gschema.override sets org.gnome.login-screen's
# "logo" key to /usr/share/pixmaps/ubuntu-logo-text-dark.svg (normally
# shipped by the base-files package). Our chisel slices for base-files
# (base-files_motd/release-info/root-defaults/chisel) don't include
# /usr/share/pixmaps at all - there is no upstream chisel slice for it.
# Without the file, loginDialog.js's _updateLogo() still resolves a
# non-null GFile for the (nonexistent) path, but _updateLogoTexture()'s
# load_file_sync() then fails and returns a null texture, and
# St.Bin.add_child(null) throws "JS ERROR: Argument child may not be
# null" out of LoginDialog's _init. The file is shipped verbatim
# (extracted from the archive's base-files_14ubuntu6.2 .deb) as
# static/usr/share/pixmaps/ubuntu-logo-text-dark.svg, which the
# Makefile copies into the rootfs before any hooks run - no action
# needed here, this comment just documents why it exists/is needed.
#
# NOTE: on its own this file is NOT enough to actually fix that JS
# ERROR - see the gdk-pixbuf loaders.cache supplied by content for
# the other half of it (gdk-pixbuf can't load *any* SVG at all here,
# this file included, until that cache exists).

# gdk-pixbuf can't load *any* image format via a loadable module
# (including SVG - both the login screen's gdm-logo above, and stock
# GNOME Shell icons like accessibility-high-contrast-symbolic.svg) until
# /usr/lib/<arch>/gdk-pixbuf-2.0/2.10.0/loaders.cache exists, listing
# which loader .so provides which format. On a real .deb install this
# is (re)generated by a dpkg trigger: librsvg2-common's postinst calls
# `dpkg-trigger --no-await .../gdk-pixbuf-2.0/*/loaders`, and
# libgdk-pixbuf-2.0-0's own trigger handler then runs
# `gdk-pixbuf-query-loaders --update-cache`. Chisel never runs
# triggers/maintainer scripts, so loaders.cache is never created here,
# gdk-pixbuf silently finds zero loaders for every format, and any code
# path that loads an image via gdk-pixbuf/GdkPixbuf (St.TextureCache,
# GTK icon themes, etc.) fails as if the file didn't exist - this is
# what caused loginDialog.js's "JS ERROR: Argument child may not be
# null" even after the gdm-theme.gresource and logo SVG fixes above.
# Regenerate the cache the same way the trigger would have (the query
# tool itself isn't on $PATH - it's a private helper binary, not a
# separate package - so call it by its full path).
gdk_pixbuf_query_loaders="$(find /usr/lib/*/gdk-pixbuf-2.0 -maxdepth 1 -name gdk-pixbuf-query-loaders)"
if [ -n "$gdk_pixbuf_query_loaders" ]; then
    gdk_pixbuf_moduledir="$(dirname "$gdk_pixbuf_query_loaders")"/2.10.0
    if [ -d "$gdk_pixbuf_moduledir"/loaders ]; then
        "$gdk_pixbuf_query_loaders" > "$gdk_pixbuf_moduledir"/loaders.cache
    # gdk-pixbuf silently ignores (treats as empty) the cache file if
    # the loaders/ directory's mtime is newer than the cache file's
    # mtime - no warning is printed, it just loads zero loaders for
    # every format. Since later build/packaging steps can touch the
    # loaders/ directory's mtime after this hook runs (e.g. repacking
    # into the snap/image), force the cache file's mtime far into the
    # future so it always wins this race, no matter what runs after.
        touch -d "2099-01-01" "$gdk_pixbuf_moduledir"/loaders.cache
    fi
fi

# loaders.cache alone was not enough: even with a valid, correctly
# ordered loaders.cache, gdk-pixbuf still failed to load *any* image
# format at all (verified: PNG failed the exact same way as SVG, both
# with "Couldn't recognize the image file format"). The reason is a
# second, near-identical chisel gap: /usr/share/mime/mime.cache
# (generated from /usr/share/mime/packages/*.xml) is also normally
# (re)built by a dpkg trigger - shared-mime-info's postinst calls
# `update-mime-database`, which chisel also never runs - and GTK/
# gdk-pixbuf's modern format sniffing goes through GIO's content-type
# detection (g_content_type_guess()), which needs this cache to
# recognize a file's MIME type before gdk-pixbuf can even pick a
# loader. Without it, format detection fails identically for every
# file, regardless of what loaders.cache says is available.
update-mime-database /usr/share/mime
# Same staleness trap as loaders.cache above: shared-mime-info compares
# mime.cache's mtime against /usr/share/mime/packages's mtime and
# silently ignores a "stale"-looking cache. Force it far into the
# future for the same reason.
touch -d "2099-01-01" /usr/share/mime/mime.cache

# accounts-daemon uses systemd to lock down the paths it can write
# to. That list of paths does not include the extrausers database used
# by Ubuntu Core.
sed -i "/^ReadWritePaths=/ a \\  /var/lib/extrausers/ \\\\" \
    /usr/lib/systemd/system/accounts-daemon.service

# Core-only schema changes are compiled here. The GNOME content snap
# carries the Ubuntu-specific wallpaper schema/property defaults.
glib-compile-schemas /usr/share/glib-2.0/schemas

# ubuntu-settings also ships /usr/lib/netplan/00-network-manager-all.yaml,
# which unconditionally forces netplan's *global* renderer to
# "NetworkManager" - fine on a real Ubuntu Desktop install, where
# NetworkManager.service is what's actually enabled/running. On this
# image, Core's own netplan config (snapd's /etc/netplan/00-snapd-config.yaml,
# plus whatever cloud-init/console-conf add on top) is designed around
# systemd-networkd, and NetworkManager.service is never enabled here at
# all. With this file in place, `netplan generate` still honours that
# global default for any interface stanza that doesn't set its own
# renderer, so the snapd-config interfaces end up with no corresponding
# systemd-networkd .network files - systemd-networkd-wait-online.service
# then waits for a interface it has nothing to say is "configured" and
# always times out (~127s) before network-online.target (and everything
# gated behind it - cloud-config.service, then gdm.service) proceeds
# anyway. Connectivity still basically works (something - most likely
# cloud-init's own NoCloud network rendering - brings the NIC up via
# DHCP directly), but only by accident, alongside a stuck wait-online
# unit and an extra ~2 minute boot delay. Remove the stray default so
# netplan's real default (networkd) applies, matching what's actually
# managing the interface.
rm -f /usr/lib/netplan/00-network-manager-all.yaml

# Remove regular Ubuntu sessions, so only confined session is available
rm -f /usr/share/wayland-sessions/ubuntu.desktop
rm -f /usr/share/wayland-sessions/ubuntu-wayland.desktop
rm -f /usr/share/wayland-sessions/ubuntu-desktop-session.desktop
rm -f /usr/share/xsessions/ubuntu-xorg.desktop
rm -f /usr/share/gnome-session/sessions/ubuntu.session

# Move GDM config to writable directory
mkdir -p /etc/writable/gdm3
mv /etc/gdm3/custom.conf /etc/writable/gdm3/custom.conf
ln -s ../writable/gdm3/custom.conf /etc/gdm3/custom.conf

# gdm3's real .deb postinst normally creates its state directory
# (/var/lib/gdm3, owned by the gdm user/group); stage-packages doesn't
# run maintainer scripts, so it never gets created - do it here since
# hooks-build/100-factory-files.build (item 10 of the rebase) expects
# it to already exist.
mkdir -p /var/lib/gdm3
chown gdm:gdm /var/lib/gdm3

# Keep the writable state directory mounted for the content-snap color
# management service, even though its package is no longer staged in core.
mkdir -p /var/lib/colord

# GDM tries to dynamically allocate a UID for its greeter session
# first ("Failed to allocate UID for greeter"), which requires writing
# to /etc/passwd - impossible on Ubuntu Core's read-only base. It then
# falls back to a static system account literally named "gdm-greeter",
# which the gdm3 .deb's own sysusers.d/gdm3.conf never creates (it only
# creates "gdm" for the daemon itself). Without it, PAM's account check
# in the gdm-launch-environment service fails
# (pam_unix: could not identify user (from getpwnam(gdm-greeter))),
# the greeter session is refused, and no Xorg/gnome-shell ever starts
# on seat0 - gdm.service stays "running" but no login screen appears.
#
# Note: this image bakes /etc/passwd,shadow,group,gshadow statically at
# build time (see hooks/000-provide-uids-gids.chroot) - systemd-sysusers
# never actually runs at boot here (ConditionNeedsUpdate is never met
# since /etc is pre-populated), so the fix for the missing account lives
# in that hook instead of a sysusers.d drop-in.

# NOTE: we used to unconditionally remove the org.gnome.Shell* systemd
# --user unit templates here ("Disable gnome-shell systemd"). That was
# carried over from the noble/24.04 setup, where gnome-session ran with
# the (Ubuntu-only) --builtin patch and never used systemd --user D-Bus
# activation at all, so these units were pure dead weight there. On
# resolute, gnome-session no longer has a --builtin mode -- systemd --user
# is mandatory -- and GDM's own shipped drop-in
# (gnome-session@gnome-login.target.d/gnome-login.session.conf) declares
# Requires=org.gnome.Shell@gdm.service for the *greeter* session (which
# runs on the host as the gdm user, separate from the confined
# ubuntu-desktop-session snap that provides the actual logged-in user's
# gnome-shell). Deleting the unit here left that Requires= dangling,
# which is why GDM could never register a graphical session (see
# todo-gnome-session.txt for the full investigation). Do not remove these
# units.

# Stop "gnome-language-selector" showing in the Dash
rm -f /usr/share/applications/gnome-language-selector.desktop
