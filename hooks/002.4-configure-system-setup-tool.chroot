#!/bin/bash -x

set -e

# provd is staged via the system-setup-tool-packages snapcraft part.
# GNOME initial-setup's profile and mode data are static host integration;
# its executable and GNOME Shell dependency closure are not staged.

# Configure provd
mkdir -p /usr/share/desktop-provision
cat > /usr/share/desktop-provision/whitelabel.yaml << \EOF
mode: core-desktop
pages:
  accessibility:
    # The a11y page is non-functional without sprovd. It's also not
    # clear it placed settings in a place the ubuntu-desktop-session
    # snap would see them.
    visible: false
  eula:
    visible: false
  ubuntu-pro-onboarding:
    visible: false
EOF

# Running ubuntu-desktop-init from /run/gnome-initial-setup as $HOME
# breaks, so run without confinement for now. Clear DCONF_PROFILE because
# the Flutter gsettings package cannot parse the file-db source in the
# initial-setup profile; the GNOME session itself still uses that profile.
sed -i 's#/snap/bin/ubuntu-desktop-init#DCONF_PROFILE= DESKTOP_PROVISION_PATH=/usr/share/desktop-provision /snap/ubuntu-desktop-init/current/bin/ubuntu_init#' /usr/libexec/launch-desktop-provision-init

# GDM's initial-setup session launches the wizard through
# gnome-initial-setup.service, whose stock ExecStart runs the Debian
# gnome-initial-setup wrapper -- which is removed below along with the
# GNOME initial-setup UI itself. Rewire the unit to run the Ubuntu wizard
# launcher instead (it starts provd, waits for its socket, then execs
# ubuntu_init from the snap).
sed -i 's#^ExecStart=.*#ExecStart=/usr/libexec/launch-desktop-provision-init#' /usr/lib/systemd/user/gnome-initial-setup.service

# remove unneeded files to free space
# The GNOME session does not use the GeoClue demo agent. Do not leave
# its host-executed autostart entry in the image.
rm -f /etc/xdg/autostart/geoclue-demo-agent.desktop

# The normal GNOME first-login and upgrade helpers are not used; Ubuntu's
# first-boot wizard is provided by ubuntu-desktop-init. Keep the separate
# GDM initial-setup session below, which launches that Ubuntu wizard.
rm -f /usr/lib/systemd/user/gnome-session.target.wants/gnome-initial-setup-copy-worker.service
rm -f /usr/lib/systemd/user/gnome-session.target.wants/gnome-initial-setup-first-login.service
rm -f /usr/lib/systemd/user/gnome-session.target.wants/gnome-initial-setup-upgrade-login.service
rm -f /usr/lib/systemd/user/graphical-session-pre.target.wants/gnome-initial-setup-copy-worker.service
rm -f /usr/share/gnome-initial-setup/vendor.conf
rm -rf /usr/share/doc/gnome-initial-setup
rm -f /usr/libexec/gnome-initial-setup
rm -f /usr/libexec/gnome-initial-setup-copy-worker
rm -f /usr/libexec/gnome-initial-setup-set-debian-keyboard
rm -f /usr/libexec/gnome-initial-setup-wrapper
rm -f /usr/lib/systemd/user/gnome-initial-setup-copy-worker.service
rm -f /usr/lib/systemd/user/gnome-initial-setup-first-login.service
rm -f /usr/lib/systemd/user/gnome-initial-setup-upgrade-login.service
rm -f /etc/xdg/autostart/gnome-initial-setup-copy-worker.desktop
rm -f /etc/xdg/autostart/gnome-initial-setup-first-login.desktop
rm -f /usr/share/applications/gnome-initial-setup.desktop
rm -f /usr/share/ubuntu/applications/gnome-initial-setup.desktop

mkdir -p /usr/share/gnome-initial-setup
test -f /usr/share/dconf/profile/gnome-initial-setup
mv /init-default.compiled /usr/share/gnome-initial-setup/initial-setup-dconf-defaults

# The GNOME initial-setup UI is not used: ubuntu-desktop-init provides the
# first-boot wizard, and the GNOME runtime is supplied by the content snap.
# Keep the dconf profile/defaults above, but drop the UI-only WebKit and
# software-rendering payload pulled in by gnome-initial-setup's dependencies.
rm -f /usr/lib/x86_64-linux-gnu/libwebkitgtk-6.0.so.4*
rm -rf /usr/lib/x86_64-linux-gnu/webkitgtk-6.0
rm -f /usr/lib/x86_64-linux-gnu/libjavascriptcoregtk-6.0.so.1*
rm -f /usr/lib/x86_64-linux-gnu/libLLVM-21.so
rm -f /usr/lib/x86_64-linux-gnu/libLLVM.so.21.*
rm -f /usr/lib/x86_64-linux-gnu/libgallium-*.so
rm -f /usr/lib/x86_64-linux-gnu/dri/*_drv_video.so

# The content snap supplies the user-session Settings app, portal
# translations, and LocalSearch translations. The host GDM greeter does
# not consume these messages or schemas.
rm -f /usr/share/glib-2.0/schemas/org.gnome.control-center.gschema.xml
rm -f /usr/share/locale/*/LC_MESSAGES/gnome-control-center-2.0.mo
rm -f /usr/share/locale/*/LC_MESSAGES/xdg-desktop-portal.mo
rm -f /usr/share/locale/*/LC_MESSAGES/xdg-desktop-portal-gnome.mo
rm -f /usr/share/locale/*/LC_MESSAGES/xdg-desktop-portal-gtk.mo
rm -f /usr/share/locale/*/LC_MESSAGES/localsearch.mo
rm -f /usr/share/locale/*/LC_MESSAGES/tinysparql.mo
rm -f /usr/share/locale/*/LC_MESSAGES/nautilus.mo
rm -f /usr/share/locale/*/LC_MESSAGES/nautilus-share.mo
rm -f /usr/share/locale/*/LC_MESSAGES/gnome-terminal.mo
