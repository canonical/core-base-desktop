#!/bin/bash -x

set -e

# gnome-initial-setup and provd are staged via the
# system-setup-tool-packages snapcraft part instead of apt-get here.

# Configure provd
mkdir -p /usr/share/desktop-provision
cat > /usr/share/desktop-provision/whitelabel.yaml << \EOF
mode: core-desktop
pages:
  accessibility:
    # The a11y page is non-functional without sprovd. It's also not
    # clear it placed settings in a place the ubuntu-desktop-session
    # snap would see them.
    visible: false
  eula:
    visible: false
  ubuntu-pro-onboarding:
    visible: false
EOF

# Running ubuntu-desktop-init from /run/gnome-initial-setup as $HOME
# breaks, so run without confinement for now. Clear DCONF_PROFILE because
# the Flutter gsettings package cannot parse the file-db source in the
# initial-setup profile; the GNOME session itself still uses that profile.
sed -i 's#/snap/bin/ubuntu-desktop-init#DCONF_PROFILE= DESKTOP_PROVISION_PATH=/usr/share/desktop-provision /snap/ubuntu-desktop-init/current/bin/ubuntu_init#' /usr/libexec/launch-desktop-provision-init

# remove unneeded files to free space
# The GNOME session does not use the GeoClue demo agent. Do not leave
# its host-executed autostart entry in the image.
rm -f /etc/xdg/autostart/geoclue-demo-agent.desktop

# The normal GNOME first-login and upgrade helpers are not used; Ubuntu's
# first-boot wizard is provided by ubuntu-desktop-init. Keep the separate
# GDM initial-setup session below, which launches that Ubuntu wizard.
rm -f /usr/lib/systemd/user/gnome-session.target.wants/gnome-initial-setup-copy-worker.service
rm -f /usr/lib/systemd/user/gnome-session.target.wants/gnome-initial-setup-first-login.service
rm -f /usr/lib/systemd/user/gnome-session.target.wants/gnome-initial-setup-upgrade-login.service
rm -f /usr/lib/systemd/user/graphical-session-pre.target.wants/gnome-initial-setup-copy-worker.service
rm -f /usr/share/gnome-initial-setup/vendor.conf
rm -rf /usr/share/doc/gnome-initial-setup
rm -f /usr/libexec/gnome-initial-setup
rm -f /usr/libexec/gnome-initial-setup-copy-worker
rm -f /usr/lib/systemd/user/gnome-initial-setup-copy-worker.service
rm -f /usr/lib/systemd/user/gnome-initial-setup-first-login.service
rm -f /usr/lib/systemd/user/gnome-initial-setup-upgrade-login.service
rm -f /etc/xdg/autostart/gnome-initial-setup-copy-worker.desktop
rm -f /etc/xdg/autostart/gnome-initial-setup-first-login.desktop
rm -f /usr/share/applications/gnome-initial-setup.desktop
rm -f /usr/share/ubuntu/applications/gnome-initial-setup.desktop

# configure the Ubuntu theme colors for the initial session
sed -i '2 i "stylesheetName": "Yaru/gnome-shell.css",' /usr/share/gnome-shell/modes/initial-setup.json
sed -i '3 i "colorScheme": "prefer-light",' /usr/share/gnome-shell/modes/initial-setup.json
sed -i '4 i "themeResourceName": "theme/Yaru/gnome-shell-theme.gresource",' /usr/share/gnome-shell/modes/initial-setup.json
sed -i '5 i "iconsResourceName": "theme/Yaru/gnome-shell-icons.gresource",' /usr/share/gnome-shell/modes/initial-setup.json

mv /init-default.compiled /usr/share/gnome-initial-setup/initial-setup-dconf-defaults
