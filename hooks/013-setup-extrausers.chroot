#!/bin/sh

set -ex

# There is no default user anymore, console-conf is responsible
# for creating one

# setup the required files for extrausers
for name in group gshadow passwd shadow subuid subgid; do
    touch /var/lib/extrausers/$name
done

# Make sure we include stubs for the admin groups accounts-daemon will
# try to add new users to (controlled by the admin_group and
# extra_admin_groups meson options).
#
# This skips over lpadmin, sambashare, libvirtd, and lxd, which aren't
# defined in /etc/group.
cat > /var/lib/extrausers/group <<EOF
adm:x:4:
cdrom:x:24:
sudo:x:27:
dip:x:30:
plugdev:x:46:
users:x:100:
EOF

cat > /var/lib/extrausers/gshadow <<EOF
users:*::
EOF

for name in gshadow shadow; do
    chmod 640 /var/lib/extrausers/$name
    chown root:shadow /var/lib/extrausers/$name
done

# Enable libnss-extrusers
sed -i 's/^passwd:.*files/\0 extrausers/' /etc/nsswitch.conf
sed -i 's/^group:.*files/\0 [SUCCESS=merge] extrausers/' /etc/nsswitch.conf
sed -i 's/^shadow:.*files/\0 extrausers/' /etc/nsswitch.conf

# gdm3 (see hooks/002.1-add-gdm.chroot) is built with HAVE_USERDB
# (varlink-based dynamic user support): instead of needing a real,
# pre-provisioned "gdm-greeter" system account, it allocates one on
# the fly and advertises it to the rest of the system as a userdb
# "multiplexer" service, registering a socket at
# /run/systemd/userdb/org.gnome.DisplayManager. That's only ever
# consulted by nss_systemd though, which isn't wired into nsswitch.conf
# by default - so classic NSS consumers like pam_unix's
# getpwnam("gdm-greeter") fail outright
# (pam_unix(gdm-launch-environment:account): could not identify user),
# the greeter's PAM session never opens, and no Xorg/gnome-shell starts
# on seat0 (gdm.service stays "running" but no login screen appears).
#
# Wire nss_systemd into passwd/group/shadow (right after "files" for
# passwd/shadow; at the end for group, so we don't disturb the
# "[SUCCESS=merge]" modifier that must stay attached to "extrausers"),
# so pam_unix (and anything else using classic getpwnam()/getspnam())
# resolves gdm3's dynamically-allocated greeter accounts through that
# same multiplexer - giving the greeter a single, consistent UID
# everywhere instead of clashing with a second one from a statically
# pre-created account.
sed -i 's/^passwd:\(.*\)files/passwd:\1files systemd/' /etc/nsswitch.conf
sed -i 's/^group:\(.*\)extrausers/group:\1extrausers systemd/' /etc/nsswitch.conf
sed -i 's/^shadow:\(.*\)files/shadow:\1files systemd/' /etc/nsswitch.conf

# systemd-userdbd is socket-activated. Stage-packages does not run the
# package's enablement scripts, so enable its socket explicitly.
mkdir -p /etc/systemd/system/sockets.target.wants
ln -sfn /usr/lib/systemd/system/systemd-userdbd.socket \
    /etc/systemd/system/sockets.target.wants/systemd-userdbd.socket

# verify pam_extrausers.so is available
grep pam_extrausers.so /etc/pam.d/common-password
grep pam_extrausers.so /etc/pam.d/common-auth

# NOTE: user-creation group membership (adduser -> usermod -a -G) and
# password setting (accounts-daemon -> chpasswd) only work against
# /var/lib/extrausers with the UCD PPA builds of shadow/adduser, which
# the Makefile overlays into the tree from debs/ -- see debs/README.txt.
# The hook tests pin that the overlay actually landed.
