#!/bin/sh -e

content_root=/snap/gnome-desktop-content/current
launcher=/usr/libexec/gnome-content-launch

# Host aliases and data paths must not retain a core fallback.
for executable in \
    /usr/bin/dconf \
    /usr/bin/gnome-session \
    /usr/bin/gnome-shell \
    /usr/libexec/gdm-auth-config-debian \
    /usr/libexec/gdm-new-session \
    /usr/libexec/gdm-runtime-config \
    /usr/libexec/gdm-session-worker \
    /usr/libexec/gdm-wayland-session \
    /usr/libexec/gdm-x-session \
    /usr/libexec/gnome-session-ctl \
    /usr/libexec/gnome-session-init-worker \
    /usr/libexec/gnome-session-service \
    /usr/libexec/gsd-a11y-settings \
    /usr/libexec/gsd-color \
    /usr/libexec/gsd-datetime \
    /usr/libexec/gsd-housekeeping \
    /usr/libexec/gsd-keyboard \
    /usr/libexec/gsd-media-keys \
    /usr/libexec/gsd-power \
    /usr/libexec/gsd-printer \
    /usr/libexec/gsd-print-notifications \
    /usr/libexec/gsd-rfkill \
    /usr/libexec/gsd-screensaver-proxy \
    /usr/libexec/gsd-sharing \
    /usr/libexec/gsd-smartcard \
    /usr/libexec/gsd-sound \
    /usr/libexec/gsd-usb-protection \
    /usr/libexec/gsd-wwan \
    /usr/libexec/gsd-xsettings
do
    if [ -e "$executable" ] || [ -L "$executable" ]; then
        rm -f "$executable"
    fi
    ln -s "$launcher" "$executable"
done

link_content_path() {
    host_path=$1
    content_path=$2
    if [ -e "$host_path" ] || [ -L "$host_path" ]; then
        rm -rf "$host_path"
    fi
    mkdir -p "$(dirname "$host_path")"
    ln -s "$content_path" "$host_path"
}

rm -f /usr/sbin/gdm3 /usr/bin/gdm-config
rm -f /usr/bin/gnome-shell-extension-tool /usr/bin/gnome-shell-test-tool
rm -f /usr/libexec/gnome-shell*
for directory in /usr/lib/gnome-settings-daemon-*; do
    if [ -e "$directory" ] || [ -L "$directory" ]; then
        rm -rf "$directory"
    fi
done

link_content_path /usr/share/gdm "$content_root/usr/share/gdm"
link_content_path /usr/share/gnome-settings-daemon \
    "$content_root/usr/share/gnome-settings-daemon"
link_content_path /usr/share/gnome-shell \
    "$content_root/usr/share/gnome-shell"
link_content_path /usr/lib/gnome-shell \
    "$content_root/usr/lib/gnome-shell"
link_content_path /usr/lib/x86_64-linux-gnu/mutter-18 \
    "$content_root/usr/lib/x86_64-linux-gnu/mutter-18"
link_content_path /usr/share/gnome-session/sessions/gnome-login.session \
    "$content_root/usr/share/gnome-session/sessions/gnome-login.session"

# Deliberately do NOT expose ubuntu.session on the host. The launcher maps
# GDM's DESKTOP_SESSION=gnome-greeter to gnome-login explicitly, while the
# logged-in user's confined session reads ubuntu.session from inside the
# ubuntu-desktop-session snap.
rm -f /usr/share/gnome-session/sessions/ubuntu.session

# GDM's host user manager needs the GNOME session unit graph and its
# Settings Daemon targets to start a usable greeter. Keep the unit payload
# in the content snap and expose only these small unit files at the host's
# systemd --user search path.
for unit in \
    gnome-session-basic-services.target \
    gnome-session-initialized.target \
    gnome-session-manager.target \
    gnome-session-manager@.service \
    gnome-session-monitor.service \
    gnome-session-pre.target \
    gnome-session-restart-dbus.service \
    gnome-session-services.target \
    gnome-session-shutdown.target \
    gnome-session-signal-init.service \
    gnome-session-x11-services-ready.target \
    gnome-session-x11-services.target \
    gnome-session.target \
    gnome-session@.target \
    org.gnome.Shell-disable-extensions.service \
    org.gnome.Shell@.service
do
    link_content_path "/usr/lib/systemd/user/$unit" \
        "$content_root/usr/lib/systemd/user/$unit"
done

for component in \
    A11ySettings \
    Color \
    Datetime \
    Housekeeping \
    Keyboard \
    MediaKeys \
    Power \
    PrintNotifications \
    Rfkill \
    ScreensaverProxy \
    Sharing \
    Smartcard \
    Sound \
    UsbProtection \
    Wwan \
    XSettings
do
    for type in target service; do
        unit="org.gnome.SettingsDaemon.$component.$type"
        link_content_path "/usr/lib/systemd/user/$unit" \
            "$content_root/usr/lib/systemd/user/$unit"
    done
done

for dropin in \
    gnome-session@gnome-login.target.d/gnome-login.session.conf \
    gnome-session@ubuntu.target.d/ubuntu.session.conf
do
    link_content_path "/usr/lib/systemd/user/$dropin" \
        "$content_root/usr/lib/systemd/user/$dropin"
done

mkdir -p /etc/systemd/system/gdm.service.d
cat >/etc/systemd/system/gdm.service.d/50-gnome-content.conf <<'EOF'
[Service]
ExecStartPre=
ExecStartPre=/usr/libexec/gnome-content-launch --content /snap/gnome-desktop-content/current/usr/share/gdm/generate-config
ExecStart=
ExecStart=/usr/libexec/gnome-content-launch --content /snap/gnome-desktop-content/current/usr/sbin/gdm3
ExecReload=
ExecReload=/usr/libexec/gnome-content-launch --content /snap/gnome-desktop-content/current/usr/share/gdm/generate-config
ExecReload=/bin/kill -SIGHUP $MAINPID
EOF
